# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.
# La clave se crea en https://platform.openai.com/api-keys (una clave solo para esta actividad)
OPENAI_API_KEY=
# Modelo que muestra la página de modelos de OpenAI; cambiarlo no requiere tocar el código
OPENAI_MODEL=
